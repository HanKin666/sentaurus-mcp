(sde:clear)
(sde:set-process-up-direction "+z")
(sdegeo:set-default-boolean "ABA")
(sdegeo:create-rectangle (position 0 0 0) (position 10 1 0) "Silicon" "SiBody")
(sdedr:define-constant-profile "NDoping" "PhosphorusActiveConcentration" 1e16)
(sdedr:define-constant-profile-region "NPlacement" "NDoping" "SiBody")
(sdegeo:define-contact-set "Left" 4 (color:rgb 1 0 0) "##")
(sdegeo:define-contact-set "Right" 4 (color:rgb 0 0 1) "##")
(sdegeo:set-contact (find-edge-id (position 0 0.5 0)) "Left")
(sdegeo:set-contact (find-edge-id (position 10 0.5 0)) "Right")
(sdedr:define-refinement-window "GlobalWindow" "Rectangle" (position 0 0 0) (position 10 1 0))
(sdedr:define-refinement-size "GlobalMesh" 0.5 0.25 0 0.25 0.125 0)
(sdedr:define-refinement-placement "GlobalPlacement" "GlobalMesh" "GlobalWindow")
(sde:save-model "smoke_geometry")
(sdeio:save-tdr-bnd (get-body-list) "smoke_bnd.tdr")
(sdedr:write-cmd-file "smoke_msh.cmd")
(system:command "snmesh smoke_msh")